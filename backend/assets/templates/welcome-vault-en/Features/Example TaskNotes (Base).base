filters:
  and:
    - file.inFolder("Features/Example TaskNotes")
    - file.hasTag("task")
properties:
  file.name:
    displayName: "Task"
  status:
    displayName: "Status"
  priority:
    displayName: "Priority"
  due:
    displayName: "Due"
  scheduled:
    displayName: "Scheduled"
  contexts:
    displayName: "Context"
  timeEstimate:
    displayName: "Estimate (min)"
views:
  - type: table
    name: "Table"
    order:
      - file.name
      - status
      - priority
      - due
      - scheduled
      - contexts
      - timeEstimate
    sort:
      - property: due
        direction: ASC
    summaries:
      file.name: Filled
      timeEstimate: Sum
  - type: tasknotesTaskList
    name: "Task list"
    order:
      - status
      - priority
      - due
      - scheduled
      - contexts
      - file.name
    sort:
      - column: due
        direction: ASC
    groupBy:
      property: status
      direction: ASC
  - type: tasknotesKanban
    name: "Kanban board"
    order:
      - status
      - priority
      - due
      - scheduled
      - contexts
      - file.name
    groupBy:
      property: status
      direction: ASC
    columnWidth: 280
    hideEmptyColumns: false
  - type: tasknotesCalendar
    name: "Calendar"
    order:
      - status
      - priority
      - due
      - scheduled
      - contexts
      - file.name
    calendarView: "dayGridMonth"
    showDue: true
    showScheduled: true
    showRecurring: false
    showTimeEntries: false
    showTimeblocks: false
    showPropertyBasedEvents: false
    firstDay: 1
  - type: tasknotesMiniCalendar
    name: "Mini calendar (due)"
    order:
      - status
      - priority
      - due
      - file.name
    dateProperty: due