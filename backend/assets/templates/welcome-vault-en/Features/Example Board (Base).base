filters:
  and:
    - file.inFolder("Features/Example Tasks")
    - 'type == "task"'
properties:
  file.name:
    displayName: "Task"
  priority:
    displayName: "Priority"
  estimate:
    displayName: "Estimate (h)"
views:
  - type: cards
    name: "By status"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - priority
      - estimate
    summaries:
      file.name: Count
      estimate: Sum
