filters:
  and:
    - file.inFolder("Features/Example Tasks")
    - 'type == "task"'
formulas:
  days_left: 'days(date(deadline), today())'
properties:
  file.name:
    displayName: "Task"
  status:
    displayName: "Status"
  priority:
    displayName: "Priority"
  deadline:
    displayName: "Deadline"
  formula.days_left:
    displayName: "Days left"
views:
  - type: table
    name: "Open tasks"
    order:
      - file.name
      - status
      - priority
      - deadline
      - formula.days_left
    sort:
      - column: priority
        direction: desc
