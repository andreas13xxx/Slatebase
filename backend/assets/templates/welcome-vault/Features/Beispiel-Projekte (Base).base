filters:
  and:
    - file.inFolder("Features/Beispiel-Projekte")
    - 'type == "project"'
properties:
  file.name:
    displayName: "Projekt"
  phase:
    displayName: "Phase"
  start:
    displayName: "Start"
  end:
    displayName: "Ende"
views:
  - type: timeline-view
    name: "Zeitleiste"
    startField: start
    endField: end
    contentField: file.name
    order:
      - file.name
      - phase
      - start
      - end
  - type: table
    name: "Liste"
    order:
      - file.name
      - phase
      - start
      - end
    sort:
      - property: start
        direction: ASC
