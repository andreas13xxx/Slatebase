filters:
  and:
    - file.inFolder("Features/Beispiel-Aufgaben")
    - 'type == "task"'
formulas:
  days_left: 'days(date(deadline), today())'
properties:
  file.name:
    displayName: "Aufgabe"
  status:
    displayName: "Status"
  priority:
    displayName: "Priorität"
  deadline:
    displayName: "Deadline"
  formula.days_left:
    displayName: "Tage übrig"
views:
  - type: table
    name: "Offene Aufgaben"
    order:
      - file.name
      - status
      - priority
      - deadline
      - formula.days_left
    sort:
      - column: priority
        direction: desc
