# Slatebase Backend Environment Variables
# Copy this file to .env and adjust values as needed.
# Environment variables take precedence over config/default.json values.
# The server is started with: node --env-file=.env src/index.ts

# Server port (default: 3000)
SLATEBASE_PORT=3000

# Host address (default: 127.0.0.1)
SLATEBASE_HOST=127.0.0.1

# Log level: debug | info | warn | error (default: info)
SLATEBASE_LOG_LEVEL=info

# Comma-separated vault paths (overrides config file vaults)
SLATEBASE_VAULT_PATHS=/path/to/vault1,/path/to/vault2

# Maximum file size in bytes (default: 5242880 = 5 MB)
SLATEBASE_MAX_FILE_SIZE=5242880

# Comma-separated allowed origins for CORS (default: http://localhost:5173)
SLATEBASE_ALLOWED_ORIGINS=http://localhost:5173

# Trusted reverse proxy IPs or CIDR ranges (comma-separated).
# When set, X-Forwarded-For is only trusted from these addresses.
# Supports: exact IPs (172.17.0.1), CIDR (10.0.0.0/8), wildcard (*), IPv6 loopback (::1 → 127.0.0.1)
# Leave empty or unset to use the direct socket IP (safe default for non-proxied setups).
# SLATEBASE_TRUSTED_PROXIES=172.17.0.1,10.0.0.0/8

# Directory for welcome vault templates (default: ./assets/templates)
# Only change if you want to use custom templates from a different location.
# SLATEBASE_TEMPLATES_DIR=./assets/templates

# CSRF secret for session tokens (min 32 chars, random generated if not set)
# SLATEBASE_CSRF_SECRET=your-csrf-secret-here-at-least-32-characters

# Sync encryption secret for credential storage (min 32 chars, random generated if not set)
# WARNING: If not set, encrypted sync credentials will not survive server restarts.
# SLATEBASE_SYNC_SECRET=your-sync-secret-here-at-least-32-characters

# MCP Context Server
# MCP is controlled by the "mcp" feature toggle (cold — requires a restart to
# take effect). Set this to override it: true enables, false disables.
SLATEBASE_FEATURE_MCP=true

# Maximum file size in bytes for MCP reads (default: 5242880 = 5 MB)
SLATEBASE_MCP_MAX_FILE_SIZE=5242880

# Maximum MCP requests per minute per token (default: 60)
SLATEBASE_MCP_RATE_LIMIT=60

# Voice Transcription (Dictation)
# Feature "voice-transcription" (cold — requires a restart). Default: OFF.
# WARNING: Speech recognition (Whisper) runs on your own server and is
# compute-intensive — without a GPU it is noticeably slow. The feature only
# works once a Whisper backend URL is set below; with the toggle on but no URL,
# dictation requests return 503.
SLATEBASE_FEATURE_VOICE_TRANSCRIPTION=false

# URL of your self-hosted Whisper HTTP backend (e.g. whisper-asr-webservice /
# faster-whisper). No default — the feature stays inactive until this is set.
# Audio is sent only here, never to a third party.
# SLATEBASE_TRANSCRIPTION_BACKEND_URL=http://whisper:9000/asr

# Request timeout in milliseconds (default: 120000 = 2 min; Whisper is slow).
# SLATEBASE_TRANSCRIPTION_TIMEOUT_MS=120000

# Maximum accepted audio size in megabytes (default: 25).
# SLATEBASE_TRANSCRIPTION_MAX_AUDIO_MB=25
