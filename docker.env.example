# Slatebase Docker Environment Configuration
# Copy this file to docker.env and adjust values for your deployment.

# --- Backend Server ---
SLATEBASE_PORT=3000
SLATEBASE_HOST=0.0.0.0
SLATEBASE_LOG_LEVEL=info

# --- CORS ---
# Set to your actual domain in production (e.g. https://slatebase.example.com)
SLATEBASE_ALLOWED_ORIGINS=http://localhost:8080

# --- Reverse Proxy ---
# Trusted proxy IPs or CIDR ranges (comma-separated).
# Only connections from these addresses will have X-Forwarded-For evaluated.
# Set to the Docker network subnet of your reverse proxy (e.g. Nginx Proxy Manager).
# Find it with: docker network inspect <network-name> --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# Examples: 172.19.0.0/16, 127.0.0.1, * (trust all — not recommended)
# Leave empty if not behind a reverse proxy.
# SLATEBASE_TRUSTED_PROXIES=172.19.0.0/16

# --- Plugin Request Proxy ---
# POST /api/v1/proxy forwards HTTP requests server-side for plugins using Obsidian's
# requestUrl() API (CORS-free). Disabled by default — an empty/unset value means the
# route always responds with 403 PROXY_NOT_CONFIGURED, it does NOT mean "allow everything".
# Comma-separated allowed target hosts; a "*." prefix matches subdomains.
# Example: SLATEBASE_PROXY_ALLOWED_ORIGINS=api.example.com,*.couchdb.example.com
# Private/internal/loopback addresses are always blocked regardless of this list.
# SLATEBASE_PROXY_ALLOWED_ORIGINS=

# --- CSRF Secret ---
# IMPORTANT: Generate a persistent secret for production!
# Run: openssl rand -hex 32
# If not set, a random secret is generated on each restart (invalidates all sessions).
SLATEBASE_CSRF_SECRET=

# --- Module Secret Key ---
# Encrypts Git-Sync remote credentials and Mail-Import mailbox passwords
# (AES-256-GCM). Run: openssl rand -hex 32
# If not set, the key is kept in the data directory instead — losing that
# directory makes every stored credential unreadable.
# Only needed if you use Git-Sync or Mail-Import.
# SLATEBASE_MODULE_SECRET_KEY=

# --- Plugin Secret Key ---
# Encrypts secrets that plugins store via the Obsidian SecretStorage API
# (AES-256-GCM). Run: openssl rand -hex 32
# If not set, the key is kept in the data directory instead — losing that
# directory makes every stored plugin secret unreadable.
# Only needed if you use plugins that store credentials.
# SLATEBASE_PLUGIN_SECRET_KEY=

# --- Vault Configuration ---
# Leave empty to use only vaults created via the UI.
# SLATEBASE_VAULT_PATHS=

# --- File Limits ---
SLATEBASE_MAX_FILE_SIZE=5242880

# --- External Port (used by docker-compose) ---
SLATEBASE_EXTERNAL_PORT=8080
