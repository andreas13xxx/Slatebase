# Slatebase Docker Environment Configuration
# Copy this file to docker.env and adjust values for your deployment.

# --- Backend Server ---
# SLATEBASE_PORT=3000
SLATEBASE_HOST=0.0.0.0
# SLATEBASE_LOG_LEVEL=info

# --- CORS ---
# Set to your actual domain in production (e.g. https://slatebase.example.com)
SLATEBASE_ALLOWED_ORIGINS=http://localhost:8080

# --- Reverse Proxy ---
# Trusted proxy IPs or CIDR ranges (comma-separated).
# Only connections from these addresses will have X-Forwarded-For evaluated.
# Set to the Docker network subnet of your reverse proxy (e.g. Nginx Proxy Manager).
# Find it with: docker network inspect <network-name> --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# Examples: 172.19.0.0/16, 127.0.0.1, * (trust all — not recommended)
# Leave empty if not behind a reverse proxy.
# SLATEBASE_TRUSTED_PROXIES=172.19.0.0/16

# --- Session Cookie ---
# Controls the Secure attribute on the session cookie. "auto" (default) sets
# it only when the request is confirmed HTTPS via X-Forwarded-Proto from a
# trusted proxy (see SLATEBASE_TRUSTED_PROXIES above) — safe for both the
# reverse-proxy-with-TLS setup and a plain HTTP LAN setup out of the box.
# If you're behind HTTPS but haven't set SLATEBASE_TRUSTED_PROXIES,
# auto-detection can't confirm it — the cookie still works, just without
# Secure. Set "true" to force it on (e.g. you trust your setup is HTTPS
# without configuring trusted proxies) or "false" to force it off (a
# pure-HTTP LAN setup where auto-detection would otherwise get it right
# anyway — this override exists for anything unusual enough to need it).
# SLATEBASE_COOKIE_SECURE=auto

# --- Plugin Request Proxy ---
# POST /api/v1/proxy forwards HTTP requests server-side for plugins using Obsidian's
# requestUrl() API (CORS-free). The allowlist is normally managed in the admin UI
# (Admin -> Server configuration -> Plugin proxy); GitHub hosts are seeded by default
# so plugin update checks and language-pack downloads work out of the box.
# Set this variable ONLY to pin the list from the deployment: it then WINS over the
# admin UI and locks that field. Comma-separated hosts, "*." prefix matches subdomains.
# An empty value (SLATEBASE_PROXY_ALLOWED_ORIGINS=) turns the proxy off entirely
# (403 PROXY_NOT_CONFIGURED). Private/internal/loopback addresses are always blocked.
# Example: SLATEBASE_PROXY_ALLOWED_ORIGINS=api.example.com,*.couchdb.example.com
# SLATEBASE_PROXY_ALLOWED_ORIGINS=

# --- Write rate limit ---
# Per-user limit on state-changing session requests (default 600/min, editor autosave
# 1500/min, stricter limits for costly routes). log-only (default): count and log
# "would block" without rejecting. enforce: answer 429 RATE_LIMITED with Retry-After.
# off: disabled. Invalid value: warning at startup, falls back to log-only.
# log-only logs at most one warning per user and rule per minute.
# SLATEBASE_WRITE_RATE_LIMIT_MODE=log-only

# --- CSRF Secret ---
# IMPORTANT: Generate a persistent secret for production!
# Run: openssl rand -hex 32
# If not set, a random secret is generated on each restart (invalidates all sessions).
SLATEBASE_CSRF_SECRET=

# --- Module Secret Key ---
# Encrypts Git-Sync remote credentials and Mail-Import mailbox passwords
# (AES-256-GCM). Run: openssl rand -hex 32
# If not set, the key is kept in the data directory instead — losing that
# directory makes every stored credential unreadable.
# Only needed if you use Git-Sync or Mail-Import.
# SLATEBASE_MODULE_SECRET_KEY=

# --- Vault Configuration ---
# Leave empty to use only vaults created via the UI.
# SLATEBASE_VAULT_PATHS=

# --- File Limits ---
# SLATEBASE_MAX_FILE_SIZE=5242880

# --- Link Index Cache ---
# Each open vault's link index (forward links, backlinks, tags, properties)
# is loaded into memory lazily, on first access, and kept there. This caps
# how many can be loaded at once — least-recently-used vaults beyond the cap
# are evicted (and transparently reloaded on next access). Raise it if you
# regularly work across more vaults than the default and have the RAM for it;
# lower it on a memory-constrained host (NAS, small VPS).
# SLATEBASE_LINK_INDEX_MAX_LOADED=20

# --- Data & Templates ---
# Where Slatebase keeps its data (inside the container the volume is /app/data).
# SLATEBASE_DATA_DIR=./data
# Folder with the vault templates shipped with the server.
# SLATEBASE_TEMPLATES_DIR=

# --- Sessions ---
# Sliding session lifetime in hours (default 24) and absolute maximum in days (default 7).
# SLATEBASE_SESSION_DURATION_HOURS=24
# SLATEBASE_SESSION_MAX_LIFETIME_DAYS=7

# --- Import Limits ---
# Max size of one imported file in bytes (default 524288000 = 500 MB),
# max number of files per import (default 500), max folder depth (default 10).
# SLATEBASE_MAX_IMPORT_FILE_SIZE=524288000
# SLATEBASE_MAX_IMPORT_FILES=500
# SLATEBASE_MAX_IMPORT_DEPTH=10

# --- MCP ---
# Max file size in bytes for MCP read/write (default 16777216 = 16 MB)
# and max requests per minute per token (default 60).
# SLATEBASE_MCP_MAX_FILE_SIZE=16777216
# SLATEBASE_MCP_RATE_LIMIT=60

# --- Realtime (SSE) ---
# Max open event streams for the whole server (default 1000) and per user (default 3).
# SLATEBASE_SSE_MAX_CONNECTIONS=1000
# SLATEBASE_SSE_MAX_PER_USER=3
# Internal tuning, normally left alone: heartbeat ms (30000), replay buffer
# entries per user (100), replay TTL ms (300000), batch window ms (100), batch max (20).
# SLATEBASE_SSE_HEARTBEAT_INTERVAL=30000
# SLATEBASE_SSE_REPLAY_BUFFER_SIZE=100
# SLATEBASE_SSE_REPLAY_TTL=300000
# SLATEBASE_SSE_BATCH_WINDOW=100
# SLATEBASE_SSE_BATCH_MAX=20

# --- Feature Toggles ---
# Any feature can be pinned per deployment: SLATEBASE_FEATURE_<NAME>=true|false
# (name uppercased, hyphens become underscores). It wins over the admin UI.
# Examples: SLATEBASE_FEATURE_GIT_SYNC=true, SLATEBASE_FEATURE_BASES=true
# SLATEBASE_FEATURE_VOICE_TRANSCRIPTION=false

# --- Voice Transcription ---
# Self-hosted Whisper backend (see the optional `whisper` service in docker-compose.yml).
# SLATEBASE_TRANSCRIPTION_BACKEND_URL=http://whisper:9000/asr
# Request timeout in ms (default 120000) and max audio size in MB (default 25).
# SLATEBASE_TRANSCRIPTION_TIMEOUT_MS=120000
# SLATEBASE_TRANSCRIPTION_MAX_AUDIO_MB=25

# --- GitHub Token (Plugin Store) ---
# Optional. Raises the GitHub API rate limit for the community plugin store.
# SLATEBASE_GITHUB_TOKEN=

# --- External Port (used by docker-compose) ---
# SLATEBASE_EXTERNAL_PORT=8080
