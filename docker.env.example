# Slatebase Docker Environment Configuration
# Copy this file to docker.env and adjust values for your deployment.

# --- Backend Server ---
SLATEBASE_PORT=3000
SLATEBASE_HOST=0.0.0.0
SLATEBASE_LOG_LEVEL=info

# --- CORS ---
# Set to your actual domain in production (e.g. https://slatebase.example.com)
SLATEBASE_ALLOWED_ORIGINS=http://localhost:8080

# --- Reverse Proxy ---
# Trusted proxy IPs or CIDR ranges (comma-separated).
# Only connections from these addresses will have X-Forwarded-For evaluated.
# Set to the Docker network subnet of your reverse proxy (e.g. Nginx Proxy Manager).
# Find it with: docker network inspect <network-name> --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# Examples: 172.19.0.0/16, 127.0.0.1, * (trust all — not recommended)
# Leave empty if not behind a reverse proxy.
# SLATEBASE_TRUSTED_PROXIES=172.19.0.0/16

# --- Session Cookie ---
# Controls the Secure attribute on the session cookie. "auto" (default) sets
# it only when the request is confirmed HTTPS via X-Forwarded-Proto from a
# trusted proxy (see SLATEBASE_TRUSTED_PROXIES above) — safe for both the
# reverse-proxy-with-TLS setup and a plain HTTP LAN setup out of the box.
# If you're behind HTTPS but haven't set SLATEBASE_TRUSTED_PROXIES,
# auto-detection can't confirm it — the cookie still works, just without
# Secure. Set "true" to force it on (e.g. you trust your setup is HTTPS
# without configuring trusted proxies) or "false" to force it off (a
# pure-HTTP LAN setup where auto-detection would otherwise get it right
# anyway — this override exists for anything unusual enough to need it).
# SLATEBASE_COOKIE_SECURE=auto

# --- Plugin Request Proxy ---
# POST /api/v1/proxy forwards HTTP requests server-side for plugins using Obsidian's
# requestUrl() API (CORS-free). Disabled by default — an empty/unset value means the
# route always responds with 403 PROXY_NOT_CONFIGURED, it does NOT mean "allow everything".
# Comma-separated allowed target hosts; a "*." prefix matches subdomains.
# Example: SLATEBASE_PROXY_ALLOWED_ORIGINS=api.example.com,*.couchdb.example.com
# Private/internal/loopback addresses are always blocked regardless of this list.
# SLATEBASE_PROXY_ALLOWED_ORIGINS=

# --- Bases Map View (Geo) ---
# Tile server for the Bases Map view (a `.base` with `type: map`). Disabled by
# default — without a tile URL the map view stays inactive.
# NOTE: every tile request sends the user's IP to this server. Point it at your
# own tile server or one you are explicitly allowed to use (OSM's public tiles
# have a fair-use policy that forbids multi-user apps). Not a hard-wired public
# server, by design — same privacy stance as the proxy allowlist above.
# Example: SLATEBASE_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# SLATEBASE_MAP_TILE_URL=
# SLATEBASE_MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors

# --- CSRF Secret ---
# IMPORTANT: Generate a persistent secret for production!
# Run: openssl rand -hex 32
# If not set, a random secret is generated on each restart (invalidates all sessions).
SLATEBASE_CSRF_SECRET=

# --- Module Secret Key ---
# Encrypts Git-Sync remote credentials and Mail-Import mailbox passwords
# (AES-256-GCM). Run: openssl rand -hex 32
# If not set, the key is kept in the data directory instead — losing that
# directory makes every stored credential unreadable.
# Only needed if you use Git-Sync or Mail-Import.
# SLATEBASE_MODULE_SECRET_KEY=

# --- Plugin Secret Key ---
# Legacy: only used once at startup to move secrets that plugins stored before
# the vault keychain existed into the keychain (which is encrypted with
# SLATEBASE_MODULE_SECRET_KEY above). Keep it until that migration has run.
# SLATEBASE_PLUGIN_SECRET_KEY=

# --- Vault Configuration ---
# Leave empty to use only vaults created via the UI.
# SLATEBASE_VAULT_PATHS=

# --- File Limits ---
SLATEBASE_MAX_FILE_SIZE=5242880

# --- Link Index Cache ---
# Each open vault's link index (forward links, backlinks, tags, properties)
# is loaded into memory lazily, on first access, and kept there. This caps
# how many can be loaded at once — least-recently-used vaults beyond the cap
# are evicted (and transparently reloaded on next access). Raise it if you
# regularly work across more vaults than the default and have the RAM for it;
# lower it on a memory-constrained host (NAS, small VPS).
# SLATEBASE_LINK_INDEX_MAX_LOADED=20

# --- External Port (used by docker-compose) ---
SLATEBASE_EXTERNAL_PORT=8080
