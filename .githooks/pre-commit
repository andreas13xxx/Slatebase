#!/usr/bin/env bash
# Pre-commit hook for Slatebase.
# Installed via: git config core.hooksPath .githooks (see CONTRIBUTING.md)
set -uo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

fail() {
  echo -e "${RED}✗ $1${NC}" >&2
  exit 1
}

# --- 1. Confirm git identity ---------------------------------------------
NAME=$(git config user.name || true)
EMAIL=$(git config user.email || true)

if { exec 3</dev/tty; } 2>/dev/null; then
  echo -e "${YELLOW}Committing as: ${NAME} <${EMAIL}>${NC}"
  read -r -p "Sind Name und E-Mail korrekt? [J/n] " REPLY <&3
  exec 3<&-
  REPLY=${REPLY:-j}
  case "$REPLY" in
    [jJyY]*) ;;
    *) fail "Commit abgebrochen. Bitte 'git config user.name'/'user.email' korrigieren (ggf. --local für dieses Repo)." ;;
  esac
else
  echo -e "${YELLOW}⚠ Kein Terminal verfügbar, Identitätsprüfung übersprungen (${NAME} <${EMAIL}>).${NC}"
fi

# --- Staged files (added/copied/modified/renamed), excluding deletions ----
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$STAGED" ] && exit 0

# --- 2. Block merge conflict markers in staged content ---------------------
CONFLICT_FILES=""
while IFS= read -r f; do
  [ -z "$f" ] && continue
  if git show ":$f" 2>/dev/null | grep -qE '^(<<<<<<<|=======$|>>>>>>>)'; then
    CONFLICT_FILES="$CONFLICT_FILES $f"
  fi
done <<< "$STAGED"
if [ -n "$CONFLICT_FILES" ]; then
  fail "Merge-Konflikt-Marker gefunden in:$CONFLICT_FILES"
fi

# --- 3a. Block likely secret/credential FILES (by name) ---------------------
SECRET_PATTERN='(^|/)\.env($|\.[^.]+$)|\.pem$|\.key$|(^|/)id_rsa(\.|$)|credentials\.json$'
SECRETS=$(echo "$STAGED" | grep -Ei "$SECRET_PATTERN" || true)
if [ -n "$SECRETS" ]; then
  fail "Mögliche Secrets/Zugangsdaten im Commit:\n$SECRETS\nFalls das ein Fehlalarm ist, Datei mit 'git commit --no-verify' committen."
fi

# --- 3b. Block secret CONTENT inside staged files ---------------------------
# A credential once sat in a doc comment of a .ts file and passed 3a untouched,
# because that rule only ever looks at file NAMES. These patterns look at the
# staged content itself.
#
# Deliberately narrow: only shapes that cannot plausibly be anything else, so
# the hook stays quiet and nobody starts reflexively reaching for --no-verify.
# The broad, entropy-based net is gitleaks in CI (see .gitleaks.toml) — this is
# the fast local pre-filter, not the authority.
#
# Escape hatch for a genuine false positive: put `gitleaks:allow` in a comment
# on the same line. That is gitleaks' own inline marker, deliberately reused
# here so one annotation satisfies both this hook and the CI scan.

# Well-known credential formats. The private-key header is anchored to the line
# start on purpose: a real PEM block starts a line, whereas the same string
# quoted inside a test or a placeholder attribute never does.
SECRET_CONTENT='^-----BEGIN [A-Z ]*PRIVATE KEY-----|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9]{10}|eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}|sk-(ant-)?[A-Za-z0-9_-]{24}'

# A password-shaped literal assigned to a password-shaped name.
PASSWORD_ASSIGN='(PASS|PASSWORD|PASSWD|PWD)[A-Za-z_]*[[:space:]]*[=:][[:space:]]*["'"'"'`]?[A-Za-z0-9!@#$%^&*_+-]{8,}'
# Names and values that are demonstrably not a credential. The tail of this
# list is the set of dummy passwords the existing test fixtures use — naming
# them explicitly beats a cleverer regex that tries to tell 'ValidPass1!' from
# a real one and gets it wrong in both directions.
PASSWORD_ALLOW='process\.env|import\.meta\.env|requireEnv|_CHARS|<[^>]*>|\$\{|\$[A-Z_]+|your-|YOUR_|xxx|changeme|example|placeholder|REPLACE|TODO|\*\*\*|ASKPASS|gitleaks:allow|ValidPass1!|password123|securepass123|wrongpass1|mypassword|secret123|unused-in-config-store'

CONTENT_HITS=""
while IFS= read -r f; do
  [ -z "$f" ] && continue
  # Skip binaries: a line-based pattern would not find anything in them anyway.
  git show ":$f" 2>/dev/null | head -c 8000 | grep -qI . || continue

  hit=$(git show ":$f" 2>/dev/null | grep -nE "$SECRET_CONTENT" | grep -v 'gitleaks:allow' || true)
  if [ -n "$hit" ]; then
    CONTENT_HITS="$CONTENT_HITS\n  $f:\n$(echo "$hit" | sed 's/^/    /')"
  fi

  hit=$(git show ":$f" 2>/dev/null | grep -nE "$PASSWORD_ASSIGN" | grep -vEi "$PASSWORD_ALLOW" || true)
  if [ -n "$hit" ]; then
    CONTENT_HITS="$CONTENT_HITS\n  $f:\n$(echo "$hit" | sed 's/^/    /')"
  fi
done <<< "$STAGED"

if [ -n "$CONTENT_HITS" ]; then
  fail "Mögliches Secret im Dateiinhalt:$CONTENT_HITS\n\nCredentials gehören in Umgebungsvariablen, nie ins Repo — auch nicht in Kommentare oder Beispielaufrufe.\nEchter Fehlalarm? 'gitleaks:allow' als Kommentar in die Zeile schreiben."
fi

# --- 4. Lint + type-check per package (only if that package has changes) ---
run_package_checks() {
  local pkg="$1"
  local files
  files=$(echo "$STAGED" | grep -E "^${pkg}/src/.*\.(ts|tsx)$" | sed "s#^${pkg}/##" || true)
  [ -z "$files" ] && return 0

  echo -e "${YELLOW}→ ESLint (${pkg}, staged files)…${NC}"
  if ! (cd "$pkg" && echo "$files" | xargs npx eslint); then
    fail "ESLint fehlgeschlagen (${pkg}). Bitte Fehler beheben oder 'npm run lint' in ${pkg}/ ausführen."
  fi

  echo -e "${YELLOW}→ TypeScript-Check (${pkg})…${NC}"
  if [ "$pkg" = "frontend" ]; then
    (cd "$pkg" && npx tsc -b --noEmit) || fail "TypeScript-Fehler (${pkg})."
  else
    (cd "$pkg" && npx tsc --noEmit -p tsconfig.json) || fail "TypeScript-Fehler (${pkg})."
  fi
}

run_package_checks backend
run_package_checks frontend

echo -e "${GREEN}✓ Pre-commit checks passed.${NC}"
