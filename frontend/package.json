{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:contracts": "npm ci --prefix ../shared-contracts && npm run build --prefix ../shared-contracts",
    "predev": "npm run build:contracts",
    "dev": "vite",
    "prebuild": "npm run build:contracts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "pretest": "npm run build:contracts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "pretest:coverage": "npm run build:contracts",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test"
  },
  "overrides": {
    "obsidian": {
      "@codemirror/state": "$@codemirror/state",
      "@codemirror/view": "$@codemirror/view",
      "moment": "$moment"
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@lezer/lr": "1.4.10",
    "@react-symbols/icons": "1.4.1",
    "@slatebase/shared-contracts": "file:../shared-contracts",
    "buffer": "^6.0.3",
    "d3-force": "3.0.0",
    "dictionary-de": "3.0.0",
    "dictionary-en": "4.0.0",
    "dompurify": "^3.4.16",
    "highlight.js": "11.12.0",
    "html-to-image": "^1.11.13",
    "jszip": "3.10.2",
    "katex": "0.19.0",
    "lucide-react": "1.52.0",
    "mermaid": "11.17.2",
    "moment": "2.31.0",
    "nspell": "2.1.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "^2.9.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-force": "3.0.10",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "obsidian": "^1.13.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.0",
    "vitest-axe": "1.0.0-pre.5"
  }
}
